#!/usr/bin/env python3
"""Audit executable admission and orientation balance for PointMaze v3."""

from __future__ import annotations

import json
from pathlib import Path

import audit_point_maze_mode_data as base


ROOT = Path(__file__).resolve().parents[1]
DATA_ROOT = ROOT / "var/data/point_maze_algorithm_repair_v3"
OUTPUT = (
    ROOT
    / "var/artifacts/"
    "point_maze_algorithm_repair_v3_admission_audit.json"
)
_atomic_json = Path.write_text


def main() -> None:
    identity = json.loads(
        (DATA_ROOT / "identity.json").read_text(encoding="utf-8")
    )
    expected_counts = {
        "train": {"0": 2, "1": 2, "2": 2, "3": 2},
        "dev": {"0": 1, "1": 1, "2": 1, "3": 1},
        "eval": {"0": 1, "1": 1, "2": 1, "3": 1},
    }
    if (
        identity.get("schema_version")
        != "point-maze-algorithm-repair-data-v3"
        or identity.get("orientation_counts") != expected_counts
        or identity.get("orientation_balanced_within_each_split") is not True
        or identity.get("executable_task_overlap_count") != 0
    ):
        raise RuntimeError("PointMaze v3 data identity balance drift")
    base.DEFAULT_DATA = DATA_ROOT
    base.DEFAULT_OUTPUT = OUTPUT
    base.main()
    receipt = json.loads(OUTPUT.read_text(encoding="utf-8"))
    receipt.update(
        schema_version=(
            "point-maze-algorithm-repair-v3-admission-audit-v1"
        ),
        decision="admitted_to_point_maze_v3_balanced_viability_gate",
        orientation_counts=expected_counts,
        orientation_balanced_within_each_split=True,
        executable_task_overlap_count=0,
    )
    temporary = OUTPUT.with_suffix(".json.tmp")
    _atomic_json(
        temporary,
        json.dumps(receipt, indent=2, sort_keys=True) + "\n",
        encoding="utf-8",
    )
    temporary.replace(OUTPUT)


if __name__ == "__main__":
    main()
