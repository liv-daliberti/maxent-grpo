#!/usr/bin/env python3
"""Render the paper's aggregate ModeBench evidence figures.

Endpoint panels read the frozen, machine-readable E65 aggregation.  Training
panels read the identity-bound E61-R1 scaling curves in the historical E68
trajectory style and stop at the same frozen domain-specific paired endpoints.
No incomplete arm or later checkpoint is carried forward.
"""

from __future__ import annotations

import json
from pathlib import Path
import sys

import matplotlib as mpl
import matplotlib.pyplot as plt
import numpy as np
from matplotlib.lines import Line2D
from matplotlib.patches import FancyArrowPatch, FancyBboxPatch, Patch
from matplotlib.ticker import MaxNLocator

ROOT = Path(__file__).resolve().parents[1]
RESULTS = ROOT / "var/artifacts/e65_five_domain_confirmation_results_latest.json"
OUT_STORY = ROOT / "paper/figures/modecollapse_story"
OUT_RESULTS = ROOT / "paper/figures/modecollapse_summary"
OUT_TRAINING = ROOT / "paper/figures/modecollapse_training"

INK = "#19324A"
MUTED = "#607487"
GRID = "#D8E2EA"
PANEL = "#F6F9FB"
WHITE = "#FFFFFF"
CONTROL = "#C76A3A"
METHOD = "#087F8C"
ACCENT = CONTROL
MODE_COLORS = ["#6C5CE7", "#E76F51", "#3A7CA5", "#2A9D8F"]

DOMAINS = ["Graph coloring", "Countdown", "Python factors", "MathIR action menu"]
SHORT = ["Graph", "Countdown", "Python", "MathIR"]
METHOD_KEY = "verified_first_global_replay_canonical"

mpl.rcParams.update(
    {
        "font.family": "DejaVu Sans",
        "font.size": 8.2,
        "axes.edgecolor": INK,
        "axes.labelcolor": INK,
        "xtick.color": INK,
        "ytick.color": INK,
        "axes.linewidth": 0.7,
        "pdf.fonttype": 42,
        "ps.fonttype": 42,
        "figure.facecolor": WHITE,
        "savefig.facecolor": WHITE,
    }
)


def rounded_box(ax, x, y, w, h, *, face=WHITE, edge=GRID, radius=0.018, lw=1.0):
    patch = FancyBboxPatch(
        (x, y),
        w,
        h,
        boxstyle=f"round,pad=0.008,rounding_size={radius}",
        transform=ax.transAxes,
        facecolor=face,
        edgecolor=edge,
        linewidth=lw,
        clip_on=False,
    )
    ax.add_patch(patch)
    return patch


def text(ax, x, y, value, *, size=8.2, weight="normal", color=INK, **kwargs):
    return ax.text(
        x,
        y,
        value,
        transform=ax.transAxes,
        fontsize=size,
        fontweight=weight,
        color=color,
        **kwargs,
    )


def arrow(ax, start, end, *, color=MUTED, lw=1.1):
    patch = FancyArrowPatch(
        start,
        end,
        transform=ax.transAxes,
        arrowstyle="-|>",
        mutation_scale=9,
        linewidth=lw,
        color=color,
        shrinkA=1,
        shrinkB=1,
        clip_on=False,
    )
    ax.add_patch(patch)


def distribution(ax, x, y, w, values, *, label_prefix="m"):
    max_value = max(values)
    for index, (value, color) in enumerate(zip(values, MODE_COLORS), start=1):
        yy = y - (index - 1) * 0.105
        text(
            ax,
            x,
            yy,
            f"{label_prefix}{index}",
            size=7.0,
            weight="bold",
            color=MUTED,
            ha="left",
            va="center",
        )
        rounded_box(
            ax,
            x + 0.037,
            yy - 0.022,
            w,
            0.044,
            face="#E8EEF3",
            edge="#E8EEF3",
            radius=0.009,
            lw=0,
        )
        rounded_box(
            ax,
            x + 0.037,
            yy - 0.022,
            max(0.012, w * value / max_value),
            0.044,
            face=color,
            edge=color,
            radius=0.009,
            lw=0,
        )


def render_story() -> None:
    fig = plt.figure(figsize=(7.35, 2.18))
    ax = fig.add_axes([0, 0, 1, 1])
    ax.set_axis_off()

    rounded_box(ax, 0.010, 0.055, 0.305, 0.885, face=PANEL, radius=0.024, lw=1.15)
    rounded_box(ax, 0.338, 0.055, 0.285, 0.885, face="#FCF7F4", radius=0.024, lw=1.15)
    rounded_box(ax, 0.646, 0.055, 0.344, 0.885, face="#F1FAF8", radius=0.024, lw=1.15)

    text(ax, 0.032, 0.842, "A", size=11.5, weight="bold", color=MODE_COLORS[0], va="center")
    text(ax, 0.065, 0.842, "Executable modes", size=11.0, weight="bold", va="center")
    text(ax, 0.034, 0.717, "response", size=7.4, weight="bold", color=MUTED, va="center")
    text(ax, 0.154, 0.717, "execute + verify", size=7.4, weight="bold", color=MUTED, va="center")
    text(ax, 0.261, 0.717, "key", size=7.4, weight="bold", color=MUTED, va="center")

    examples = [
        ("1×2×3×4", "AST-1", MODE_COLORS[0]),
        ("(1+3)×(2+4)", "AST-2", MODE_COLORS[1]),
        ("4×(3+2+1)", "AST-3", MODE_COLORS[2]),
        ("4×4+…", "invalid", MUTED),
    ]
    for row, (response, key, color) in enumerate(examples):
        yy = 0.600 - row * 0.128
        rounded_box(ax, 0.034, yy - 0.037, 0.092, 0.074, face=WHITE, edge=GRID, radius=0.010)
        text(ax, 0.080, yy, response, size=7.2, weight="bold", ha="center", va="center")
        arrow(ax, (0.132, yy), (0.208, yy), color=GRID, lw=1.0)
        rounded_box(
            ax,
            0.214,
            yy - 0.037,
            0.077,
            0.074,
            face=WHITE if key != "invalid" else "#EEF1F4",
            edge=color,
            radius=0.010,
        )
        text(ax, 0.2525, yy, key, size=7.0, weight="bold", color=color, ha="center", va="center")
    text(
        ax,
        0.163,
        0.090,
        "format aliases merge; executed alternatives remain distinct",
        size=6.8,
        color=MUTED,
        ha="center",
        va="center",
    )

    text(ax, 0.360, 0.842, "B", size=11.5, weight="bold", color=ACCENT, va="center")
    text(ax, 0.393, 0.842, "Dr.GRPO collapse", size=10.2, weight="bold", va="center")
    text(ax, 0.363, 0.725, "all correct modes receive reward 1", size=7.4, color=MUTED, va="center")
    distribution(ax, 0.366, 0.602, 0.202, [0.90, 0.14, 0.07, 0.04])
    text(ax, 0.482, 0.130, "frequency-weighted updates", size=7.3, weight="bold", color=ACCENT, ha="center")
    text(ax, 0.482, 0.072, "no force restores a missed mode", size=6.8, color=MUTED, ha="center")

    text(ax, 0.668, 0.842, "C", size=11.5, weight="bold", color=METHOD, va="center")
    text(ax, 0.701, 0.842, "xDr.GRPO", size=10.5, weight="bold", va="center")
    text(ax, 0.701, 0.755, "online verified MaxEnt", size=7.0, color=MUTED, va="center")
    rounded_box(ax, 0.676, 0.630, 0.083, 0.086, face=WHITE, edge=METHOD, radius=0.012)
    rounded_box(ax, 0.780, 0.630, 0.083, 0.086, face=WHITE, edge=METHOD, radius=0.012)
    rounded_box(ax, 0.884, 0.630, 0.083, 0.086, face=WHITE, edge=METHOD, radius=0.012)
    text(ax, 0.7175, 0.673, "verified\nbank", size=7.2, weight="bold", color=METHOD, ha="center", va="center")
    text(ax, 0.8215, 0.673, "rare + new\nadvantage", size=7.0, weight="bold", color=METHOD, ha="center", va="center")
    text(ax, 0.9255, 0.673, "global\nreplay", size=7.2, weight="bold", color=METHOD, ha="center", va="center")
    arrow(ax, (0.761, 0.673), (0.777, 0.673), color=METHOD)
    arrow(ax, (0.865, 0.673), (0.881, 0.673), color=METHOD)
    distribution(ax, 0.722, 0.500, 0.200, [0.95, 0.82, 0.77, 0.70])
    text(ax, 0.842, 0.090, "pressure acts only on validator-positive execution modes", size=6.8, color=MUTED, ha="center")

    text(ax, 0.986, 0.965, "schematic", size=6.4, color=MUTED, ha="right", va="top")
    OUT_STORY.parent.mkdir(parents=True, exist_ok=True)
    fig.savefig(OUT_STORY.with_suffix(".pdf"), bbox_inches="tight", pad_inches=0.04)
    fig.savefig(OUT_STORY.with_suffix(".png"), dpi=240, bbox_inches="tight", pad_inches=0.04)
    plt.close(fig)


def load_document() -> dict:
    with RESULTS.open(encoding="utf-8") as handle:
        return json.load(handle)


def load_shared() -> dict:
    return load_document()["interim_shared_e58"]


def metric_rows(shared: dict, metric: str):
    control_means = []
    method_means = []
    control_ranges = []
    method_ranges = []
    passes = []
    for domain in DOMAINS:
        block = shared[domain]
        passes.append(int(block["pass"]))
        if metric == "excess8":
            pass_block = block["metrics"]["pass8"]
            distinct_block = block["metrics"]["distinct8"]
            control_values = [
                distinct_block["grpo"]["seeds"][seed] - pass_block["grpo"]["seeds"][seed]
                for seed in ("43", "44", "45")
            ]
            method_values = [
                distinct_block[METHOD_KEY]["seeds"][seed] - pass_block[METHOD_KEY]["seeds"][seed]
                for seed in ("43", "44", "45")
            ]
            control_means.append(float(np.mean(control_values)))
            method_means.append(float(np.mean(method_values)))
            control_ranges.append((min(control_values), max(control_values)))
            method_ranges.append((min(method_values), max(method_values)))
        else:
            metric_block = block["metrics"][metric]
            control = metric_block["grpo"]
            method = metric_block[METHOD_KEY]
            control_means.append(float(control["mean"]))
            method_means.append(float(method["mean"]))
            control_ranges.append((float(control["min"]), float(control["max"])))
            method_ranges.append((float(method["min"]), float(method["max"])))
    return control_means, method_means, control_ranges, method_ranges, passes


def paired_panel(ax, shared: dict, metric: str, title: str, xlabel: str, xmax: float) -> None:
    control, method, crange, mrange, passes = metric_rows(shared, metric)
    ypos = np.arange(len(DOMAINS))[::-1]
    for index, y in enumerate(ypos):
        ax.plot([control[index], method[index]], [y, y], color=GRID, lw=2.0, zorder=1)
        ax.plot(crange[index], [y + 0.10, y + 0.10], color=CONTROL, lw=1.1, alpha=0.75, zorder=2)
        ax.plot(mrange[index], [y - 0.10, y - 0.10], color=METHOD, lw=1.1, alpha=0.75, zorder=2)
        ax.scatter(control[index], y + 0.10, s=32, color=CONTROL, edgecolor=WHITE, linewidth=0.55, zorder=3)
        ax.scatter(method[index], y - 0.10, s=37, color=METHOD, edgecolor=WHITE, linewidth=0.55, zorder=3)
        ax.text(xmax * 0.99, y, f"pass {passes[index]}", ha="right", va="center", fontsize=6.8, color=MUTED)
    ax.set_yticks(ypos, SHORT)
    ax.set_xlim(0, xmax)
    ax.set_ylim(-0.55, len(DOMAINS) - 0.45)
    ax.set_title(title, loc="left", fontsize=9.8, fontweight="bold", color=INK, pad=7)
    ax.set_xlabel(xlabel)
    ax.grid(axis="x", color=GRID, lw=0.55, zorder=0)
    ax.spines[["top", "right", "left"]].set_visible(False)
    ax.tick_params(axis="y", length=0, pad=4)
    ax.tick_params(axis="x", length=2.3, pad=2)


def render_results() -> None:
    shared = load_shared()
    fig, axes = plt.subplots(1, 2, figsize=(7.30, 2.65), gridspec_kw={"wspace": 0.34})
    paired_panel(
        axes[0],
        shared,
        "pass8",
        "A   Finding at least one correct mode",
        "pass@8",
        1.05,
    )
    paired_panel(
        axes[1],
        shared,
        "excess8",
        "B   Breadth beyond the first correct mode",
        "excess@8 = distinct@8 − pass@8",
        1.55,
    )
    legend = [
        Line2D([0], [0], marker="o", color="none", markerfacecolor=CONTROL, markeredgecolor=WHITE, markersize=6, label="matched Dr.GRPO"),
        Line2D([0], [0], marker="o", color="none", markerfacecolor=METHOD, markeredgecolor=WHITE, markersize=6, label="xDr.GRPO"),
    ]
    fig.legend(handles=legend, loc="lower center", ncol=2, frameon=False, bbox_to_anchor=(0.5, -0.01), fontsize=8.0)
    fig.subplots_adjust(left=0.115, right=0.995, top=0.88, bottom=0.245)
    OUT_RESULTS.parent.mkdir(parents=True, exist_ok=True)
    fig.savefig(OUT_RESULTS.with_suffix(".pdf"), bbox_inches="tight", pad_inches=0.035)
    fig.savefig(OUT_RESULTS.with_suffix(".png"), dpi=240, bbox_inches="tight", pad_inches=0.035)
    plt.close(fig)


TRAIN_METRICS = {
    "greedy": {
        "label": "Greedy pass@1",
        "short_label": "pass@1",
        "suffix": "pass1",
        "ylabel": "success probability",
    },
    "pass8": {
        "label": "At-least-one success: pass@8",
        "short_label": "pass@8",
        "suffix": "pass8",
        "ylabel": "success probability",
    },
    "distinct8": {
        "label": "Distinct correct modes@8",
        "short_label": "distinct@8",
        "suffix": "distinct8",
        "ylabel": "expected correct modes",
    },
}


def shared_training_series(document: dict, domain: str) -> tuple[list[int], dict]:
    arms = document["domains"][domain]["arms"]
    series = {}
    pass_sets = []
    expected_seeds = {"43", "44", "45"}
    for arm in ("grpo", METHOD_KEY):
        series[arm] = {}
        for metric in TRAIN_METRICS:
            points = arms[arm]["metrics"][metric]["points"]
            values = {
                int(point["pass"]): {
                    "mean": float(point["mean"]),
                    "min": float(point["min"]),
                    "max": float(point["max"]),
                }
                for point in points
                if set(point["seeds"]) == expected_seeds
            }
            series[arm][metric] = values
            pass_sets.append(set(values))

    passes = sorted(set.intersection(*pass_sets))
    frozen_pass = int(document["interim_shared_e58"][domain]["pass"])
    if not passes or passes[-1] != frozen_pass:
        raise ValueError(
            f"{domain}: paired training surface ends at {passes[-1] if passes else None}, "
            f"but frozen endpoint is pass {frozen_pass}"
        )
    return passes, series


def plot_training_axis(
    ax,
    passes: list[int],
    series: dict,
    metric: str,
    *,
    annotate_excess: bool = False,
) -> None:
    for arm, color in (("grpo", CONTROL), (METHOD_KEY, METHOD)):
        rows = [series[arm][metric][p] for p in passes]
        means = np.array([row["mean"] for row in rows])
        lows = np.array([row["min"] for row in rows])
        highs = np.array([row["max"] for row in rows])
        ax.fill_between(
            passes,
            lows,
            highs,
            color=color,
            alpha=0.10 if arm == "grpo" else 0.13,
            linewidth=0,
            zorder=1,
        )
        ax.plot(
            passes,
            means,
            color=color,
            linewidth=1.8,
            marker="o",
            markersize=2.8,
            markerfacecolor=WHITE,
            markeredgecolor=color,
            markeredgewidth=0.70,
            zorder=3,
        )

    last_pass = passes[-1]
    ticks = sorted(set(range(0, last_pass + 1, 2)) | {last_pass})
    ax.set_xlim(-0.15, last_pass + 0.25)
    ax.set_xticks(ticks)
    if metric in {"greedy", "pass8"}:
        ax.set_ylim(-0.025, 1.035)
        ax.set_yticks([0.0, 0.5, 1.0])
    else:
        peak = max(
            series[arm][metric][p]["max"]
            for arm in ("grpo", METHOD_KEY)
            for p in passes
        )
        ax.set_ylim(-0.025, max(1.04, peak * 1.10))
        ax.locator_params(axis="y", nbins=4)

    if annotate_excess:
        control_excess = (
            series["grpo"]["distinct8"][last_pass]["mean"]
            - series["grpo"]["pass8"][last_pass]["mean"]
        )
        method_excess = (
            series[METHOD_KEY]["distinct8"][last_pass]["mean"]
            - series[METHOD_KEY]["pass8"][last_pass]["mean"]
        )
        ax.text(
            0.03,
            0.94,
            f"final excess@8\nDr {control_excess:.2f}  |  xDr {method_excess:.2f}",
            transform=ax.transAxes,
            ha="left",
            va="top",
            fontsize=5.8,
            color=MUTED,
            bbox={"facecolor": WHITE, "edgecolor": "none", "alpha": 0.82, "pad": 1.2},
            zorder=4,
        )

    ax.set_facecolor("#FBFCFD")
    ax.grid(axis="both", color=GRID, linewidth=0.50, alpha=0.85, zorder=0)
    ax.spines[["top", "right"]].set_visible(False)
    ax.tick_params(length=2.2, pad=1.5, labelsize=6.6)


def training_legend():
    return [
        Line2D([0], [0], color=CONTROL, lw=2.1, marker="o", markersize=3.2, label="matched Dr.GRPO"),
        Line2D([0], [0], color=METHOD, lw=2.1, marker="o", markersize=3.2, label="xDr.GRPO"),
        Patch(facecolor=INK, alpha=0.11, edgecolor="none", label="three-seed range"),
    ]


def render_training() -> None:
    """Render a paper composite with one axis per metric and domain."""

    document = load_document()
    metrics = tuple(TRAIN_METRICS)
    fig, axes = plt.subplots(len(DOMAINS), len(metrics), figsize=(7.35, 5.40))

    for row_index, (domain, short) in enumerate(zip(DOMAINS, SHORT)):
        passes, series = shared_training_series(document, domain)
        for column_index, metric in enumerate(metrics):
            ax = axes[row_index, column_index]
            plot_training_axis(
                ax,
                passes,
                series,
                metric,
                annotate_excess=metric == "distinct8",
            )
            if row_index == 0:
                ax.set_title(
                    f"{chr(65 + column_index)}   {TRAIN_METRICS[metric]['short_label']}",
                    loc="left",
                    fontsize=8.8,
                    fontweight="bold",
                    color=INK,
                    pad=7,
                )
            if column_index == 0:
                ax.set_ylabel(
                    f"{short}\npaired to p{passes[-1]}",
                    fontsize=7.0,
                    fontweight="bold",
                    color=INK,
                    rotation=0,
                    ha="right",
                    va="center",
                    labelpad=23,
                )
                ax.yaxis.set_label_coords(-0.24, 0.5)
            if row_index == len(DOMAINS) - 1:
                ax.set_xlabel("training pass", fontsize=7.1)

    fig.legend(
        handles=training_legend(),
        loc="lower center",
        ncol=3,
        frameon=False,
        bbox_to_anchor=(0.5, 0.008),
        fontsize=7.5,
        handlelength=2.4,
        columnspacing=1.55,
    )
    fig.subplots_adjust(left=0.125, right=0.995, top=0.955, bottom=0.085, hspace=0.48, wspace=0.25)
    OUT_TRAINING.parent.mkdir(parents=True, exist_ok=True)
    fig.savefig(OUT_TRAINING.with_suffix(".pdf"), bbox_inches="tight", pad_inches=0.035)
    fig.savefig(OUT_TRAINING.with_suffix(".png"), dpi=240, bbox_inches="tight", pad_inches=0.035)
    plt.close(fig)


def render_training_metric(document: dict, metric: str) -> Path:
    """Render one standalone 2x2 domain figure for a single metric."""

    metadata = TRAIN_METRICS[metric]
    out = OUT_TRAINING.with_name(f"modecollapse_training_{metadata['suffix']}")
    fig, axes = plt.subplots(2, 2, figsize=(7.35, 4.75))
    for panel_index, (ax, domain, short) in enumerate(zip(axes.flat, DOMAINS, SHORT)):
        passes, series = shared_training_series(document, domain)
        plot_training_axis(
            ax,
            passes,
            series,
            metric,
            annotate_excess=metric == "distinct8",
        )
        ax.set_title(
            f"{chr(65 + panel_index)}   {short}",
            loc="left",
            fontsize=9.2,
            fontweight="bold",
            color=INK,
            pad=6,
        )
        ax.text(
            0.99,
            1.025,
            f"paired through pass {passes[-1]}",
            transform=ax.transAxes,
            ha="right",
            va="bottom",
            fontsize=6.6,
            color=MUTED,
        )
        ax.set_xlabel("training pass", fontsize=7.4)
        if panel_index % 2 == 0:
            ax.set_ylabel(metadata["ylabel"], fontsize=7.4)

    fig.suptitle(metadata["label"], fontsize=11.2, fontweight="bold", color=INK, y=0.995)
    fig.legend(
        handles=training_legend(),
        loc="lower center",
        ncol=3,
        frameon=False,
        bbox_to_anchor=(0.5, 0.006),
        fontsize=7.7,
        columnspacing=1.6,
    )
    fig.subplots_adjust(left=0.09, right=0.995, top=0.90, bottom=0.16, hspace=0.42, wspace=0.22)
    fig.savefig(out.with_suffix(".pdf"), bbox_inches="tight", pad_inches=0.035)
    fig.savefig(out.with_suffix(".png"), dpi=240, bbox_inches="tight", pad_inches=0.035)
    plt.close(fig)
    return out


def main() -> None:
    render_results()
    render_training()
    document = load_document()
    standalone = [render_training_metric(document, metric) for metric in TRAIN_METRICS]
    outputs = [OUT_RESULTS, OUT_TRAINING, *standalone]
    print("wrote " + ", ".join(f"{output}.{{pdf,png}}" for output in outputs))


if __name__ == "__main__":
    main()
