+def main():
+    subprocess.run([sys.executable, str(ROOT / 'check_submission.py')], check=True)
+    sources, _ = check_sources(json.loads((ROOT / 'snapshot.json').read_text()))
+    receipt = json.loads((ROOT / 'build_receipt.json').read_text())
