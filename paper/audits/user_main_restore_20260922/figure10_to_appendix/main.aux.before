\@writefile{lof}{\contentsline {figure}{\numberline {15}{\ignorespaces \textbf  {High accuracy can coexist with low solution diversity.} Each row shows one frozen checkpoint across five domains, with \texttt  {pass@8} on the horizontal axis and \texttt  {PCMD}{} on the vertical axis. Colour indicates parameter count and marker shape indicates level. Each cell uses four groups of eight responses to 128 held-out prompts at $T=1$; \texttt  {PCMD}{} pools the groups within each prompt. Filled marks have at least 30 prompts with two correct responses; hollow marks have 5--29, with one-standard-error bars. Ticks below the axis indicate fewer than five such prompts.}}{26}{figure.95}\protected@file@percent }
\newlabel{fig:level-construction}{{15}{26}{\textbf {High accuracy can coexist with low solution diversity.} Each row shows one frozen checkpoint across five domains, with \texttt {pass@8} on the horizontal axis and \pmd {} on the vertical axis. Colour indicates parameter count and marker shape indicates level. Each cell uses four groups of eight responses to 128 held-out prompts at $T=1$; \pmd {} pools the groups within each prompt. Filled marks have at least 30 prompts with two correct responses; hollow marks have 5--29, with one-standard-error bars. Ticks below the axis indicate fewer than five such prompts}{figure.95}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {16}{\ignorespaces \textbf  {Every hosted deployment has lower mean solution diversity at Level 3 than at Level 1.} Lines show \texttt  {PCMD}{} for 7{} deployments, using eight responses to each of 128 held-out prompts per cell. Panels show individual domains and their equally weighted average over a domain set fixed across levels for each deployment. Darker lines indicate higher overall diversity; hollow marks fall below the 30-prompt support threshold and are excluded from connecting lines. Higher levels increase task difficulty and add strategy guidance in \texttt  {MathIR}, \texttt  {Python}, and \texttt  {PantryPlan} (App.\nobreakspace  {}\ref  {app:prompt-hint-ablation}).}}{27}{figure.97}\protected@file@percent }
\newlabel{fig:frontier-level-grid}{{16}{27}{\textbf {Every hosted deployment has lower mean solution diversity at Level 3 than at Level 1.} Lines show \pmd {} for \MDfrontierdeployments {} deployments, using eight responses to each of 128 held-out prompts per cell. Panels show individual domains and their equally weighted average over a domain set fixed across levels for each deployment. Darker lines indicate higher overall diversity; hollow marks fall below the 30-prompt support threshold and are excluded from connecting lines. Higher levels increase task difficulty and add strategy guidance in \texttt {MathIR}, \texttt {Python}, and \texttt {PantryPlan} (App.~\ref {app:prompt-hint-ablation})}{figure.97}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {17}{\ignorespaces \textbf  {Parameter count does not determine solution diversity across model families.} Frozen SmolLM2, Qwen2.5, Falcon3, and OLMo-2 checkpoints are plotted by \texttt  {pass@8} and \texttt  {PCMD}{} across five domains and the available levels. Colour indicates parameter count on a logarithmic scale; marker shape indicates level. Black marks show the 7{} hosted deployments. Frozen checkpoints use four groups of eight responses to 128 held-out prompts per cell; hosted deployments use eight responses per prompt. Filled marks use at least 30 prompts with two correct responses; hollow marks use 5--29 and show one-standard-error bars. Ticks below the axis indicate fewer than five defining prompts.}}{27}{figure.99}\protected@file@percent }
\newlabel{fig:families-appendix}{{17}{27}{\textbf {Parameter count does not determine solution diversity across model families.} Frozen SmolLM2, Qwen2.5, Falcon3, and OLMo-2 checkpoints are plotted by \texttt {pass@8} and \pmd {} across five domains and the available levels. Colour indicates parameter count on a logarithmic scale; marker shape indicates level. Black marks show the \MDfrontierdeployments {} hosted deployments. Frozen checkpoints use four groups of eight responses to 128 held-out prompts per cell; hosted deployments use eight responses per prompt. Filled marks use at least 30 prompts with two correct responses; hollow marks use 5--29 and show one-standard-error bars. Ticks below the axis indicate fewer than five defining prompts}{figure.99}{}}
