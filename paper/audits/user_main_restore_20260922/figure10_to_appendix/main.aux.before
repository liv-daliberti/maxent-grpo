\@writefile{lof}{\contentsline {figure}{\numberline {22}{\ignorespaces \textbf  {Replay limits the loss of \texttt  {PantryPlan} solution diversity at every scale.} \texttt  {PCMD}{} throughout training, with model rows and method colours as in Fig.\nobreakspace  {}\ref  {fig:factorial-training-accuracy}. Both fresh objectives reach zero terminal \texttt  {PantryPlan} diversity at 0.5B and 1B, whereas both replay variants retain multiple solution modes. Lines average one to five eligible seeds per checkpoint; bands show seed ranges and are absent for a single seed. A seed contributes when at least five prompts yield two correct responses. Fine dotted segments use fewer seeds, so changes can reflect sample composition. Gaps indicate undefined estimates. Vertical scales are shared within each domain.}}{39}{figure.162}\protected@file@percent }
\newlabel{fig:factorial-training-modes}{{22}{39}{\textbf {Replay limits the loss of \texttt {PantryPlan} solution diversity at every scale.} \pmd {} throughout training, with model rows and method colours as in Fig.~\ref {fig:factorial-training-accuracy}. Both fresh objectives reach zero terminal \texttt {PantryPlan} diversity at 0.5B and 1B, whereas both replay variants retain multiple solution modes. Lines average one to five eligible seeds per checkpoint; bands show seed ranges and are absent for a single seed. A seed contributes when at least five prompts yield two correct responses. Fine dotted segments use fewer seeds, so changes can reflect sample composition. Gaps indicate undefined estimates. Vertical scales are shared within each domain}{figure.162}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {23}{\ignorespaces \textbf  {Replay improves final accuracy and verified-mode counts at Level\nobreakspace  {}2.} Qwen2.5-0.5B trajectories for Dr.GRPO, Re:Dr, MaxRL, and Re:Max across five domains. Rows show \texttt  {pass@8} and \texttt  {distinct@8}{}; the latter depends on both correctness and solution diversity. Each objective pair has five terminal seeds. Lines show seed means and bands their ranges; ringed points use fewer than five seeds. Fig.\nobreakspace  {}\ref  {fig:level2-training-pmd} shows success-conditional diversity.}}{40}{figure.164}\protected@file@percent }
\newlabel{fig:level2-training-curves}{{23}{40}{\textbf {Replay improves final accuracy and verified-mode counts at Level~2.} Qwen2.5-0.5B trajectories for Dr.GRPO, Re:Dr, MaxRL, and Re:Max across five domains. Rows show \texttt {pass@8} and \distk {}; the latter depends on both correctness and solution diversity. Each objective pair has five terminal seeds. Lines show seed means and bands their ranges; ringed points use fewer than five seeds. Fig.~\ref {fig:level2-training-pmd} shows success-conditional diversity}{figure.164}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {24}{\ignorespaces \textbf  {Replay preserves greater solution diversity on Level-2 \texttt  {Graph}.} \texttt  {PCMD}{} during Qwen2.5-0.5B training for the four primary methods. At the terminal checkpoint, Re:Dr and Re:Max reach $.346$ and $.325$, compared with $.023$ for Dr.GRPO and $.112$ for MaxRL. \texttt  {MathIR} remains near zero under all four methods. Lines average eligible seeds and bands show seed ranges. Each seed requires at least five prompts with two correct responses. Fine dotted segments use fewer seeds; gaps indicate undefined estimates.}}{40}{figure.166}\protected@file@percent }
\newlabel{fig:level2-training-pmd}{{24}{40}{\textbf {Replay preserves greater solution diversity on Level-2 \texttt {Graph}.} \pmd {} during Qwen2.5-0.5B training for the four primary methods. At the terminal checkpoint, Re:Dr and Re:Max reach $.346$ and $.325$, compared with $.023$ for Dr.GRPO and $.112$ for MaxRL. \texttt {MathIR} remains near zero under all four methods. Lines average eligible seeds and bands show seed ranges. Each seed requires at least five prompts with two correct responses. Fine dotted segments use fewer seeds; gaps indicate undefined estimates}{figure.166}{}}
