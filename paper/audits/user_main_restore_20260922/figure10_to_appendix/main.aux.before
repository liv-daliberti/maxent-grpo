\@writefile{lof}{\contentsline {figure}{\numberline {19}{\ignorespaces \textbf  {Replay gains vary by domain and model scale.} Terminal \texttt  {pass@8} and \texttt  {PCMD}{} at three scales. Open/filled marks denote fresh/replay methods; circles denote Dr.GRPO, squares MaxRL, and gray diamonds the untrained checkpoint. Correctness uses five paired seeds except Falcon \texttt  {Countdown} Dr.GRPO ($n=4$). Diversity averages each arm's eligible seeds separately, requiring at least 30 defining prompts per seed. Line style follows the control's seed count: solid for five, dashed for fewer. Seed counts can differ between arms; estimates below the support threshold are not plotted. Table\nobreakspace  {}\ref  {tab:cross-scale-terminal-effects} gives paired diversity effects at a 20-prompt threshold. No error bars are shown.}}{36}{figure.150}\protected@file@percent }
\newlabel{fig:maxrl-factorial-scale-extensions}{{19}{36}{\textbf {Replay gains vary by domain and model scale.} Terminal \texttt {pass@8} and \pmd {} at three scales. Open/filled marks denote fresh/replay methods; circles denote Dr.GRPO, squares MaxRL, and gray diamonds the untrained checkpoint. Correctness uses five paired seeds except Falcon \texttt {Countdown} Dr.GRPO ($n=4$). Diversity averages each arm's eligible seeds separately, requiring at least 30 defining prompts per seed. Line style follows the control's seed count: solid for five, dashed for fewer. Seed counts can differ between arms; estimates below the support threshold are not plotted. Table~\ref {tab:cross-scale-terminal-effects} gives paired diversity effects at a 20-prompt threshold. No error bars are shown}{figure.150}{}}
