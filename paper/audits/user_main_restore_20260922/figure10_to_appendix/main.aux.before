\@writefile{lof}{\contentsline {figure}{\numberline {20}{\ignorespaces \textbf  {Replay improves Level-2 \texttt  {Graph} accuracy and solution diversity.} Paired terminal effects of Re:Dr minus Dr.GRPO (circles) and Re:Max minus MaxRL (squares) for Qwen2.5-0.5B, in percentage points of \texttt  {pass@8} and changes in \texttt  {PCMD}{}. Correctness uses five paired seeds per domain. Diversity requires at least 20 defining prompts per arm. Re:Dr uses three seeds for \texttt  {Graph} and \texttt  {PantryPlan}, four for \texttt  {MathIR}, and none for \texttt  {Countdown}; Re:Max uses one for \texttt  {Countdown} and four for \texttt  {PantryPlan}. Other comparisons use five. Open marks indicate fewer than five pairs; blanks indicate no eligible pair. Bars are nominal paired 95\% Student-$t$ intervals where at least two seeds contribute.}}{37}{figure.154}\protected@file@percent }
\newlabel{fig:replay-level2-effects}{{20}{37}{\textbf {Replay improves Level-2 \texttt {Graph} accuracy and solution diversity.} Paired terminal effects of Re:Dr minus Dr.GRPO (circles) and Re:Max minus MaxRL (squares) for Qwen2.5-0.5B, in percentage points of \texttt {pass@8} and changes in \pmd {}. Correctness uses five paired seeds per domain. Diversity requires at least 20 defining prompts per arm. Re:Dr uses three seeds for \texttt {Graph} and \texttt {PantryPlan}, four for \texttt {MathIR}, and none for \texttt {Countdown}; Re:Max uses one for \texttt {Countdown} and four for \texttt {PantryPlan}. Other comparisons use five. Open marks indicate fewer than five pairs; blanks indicate no eligible pair. Bars are nominal paired 95\% Student-$t$ intervals where at least two seeds contribute}{figure.154}{}}
\@writefile{lot}{\contentsline {table}{\numberline {9}{\ignorespaces \textbf  {A stronger fresh objective need not increase replay's additional benefit.} Five common seeds per domain for all four methods. The interaction is $(\mathrm  {Re:Max}-\mathrm  {MaxRL})-(\mathrm  {Re:Dr}-\mathrm  {Dr.GRPO})$. Here $P_8=\texttt  {pass@8}$, $D_8=\texttt  {distinct@8}$, and $B_8=D_8-P_8$. Entries give paired means and nominal 95\% Student-$t$ intervals. Both count metrics depend on correctness. The conditional-diversity effects in Fig.\nobreakspace  {}\ref  {fig:replay-level2-effects} use separate support thresholds and seed populations.}}{37}{table.156}\protected@file@percent }
\newlabel{tab:level2-factorial-contrasts}{{9}{37}{\textbf {A stronger fresh objective need not increase replay's additional benefit.} Five common seeds per domain for all four methods. The interaction is $(\mathrm {Re:Max}-\mathrm {MaxRL})-(\mathrm {Re:Dr}-\mathrm {Dr.GRPO})$. Here $P_8=\texttt {pass@8}$, $D_8=\texttt {distinct@8}$, and $B_8=D_8-P_8$. Entries give paired means and nominal 95\% Student-$t$ intervals. Both count metrics depend on correctness. The conditional-diversity effects in Fig.~\ref {fig:replay-level2-effects} use separate support thresholds and seed populations}{table.156}{}}
