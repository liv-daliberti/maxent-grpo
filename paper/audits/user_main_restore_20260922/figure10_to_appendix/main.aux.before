\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces \textbf  {Training reduces solution mode diversity.} We compare \texttt  {PCMD}{} before and after RLVR on Qwen2.5-3B, over \textsc  {ModeBench}{} Level 1 test set, under three objectives, five domains, five seeds. The figure shows the change in \texttt  {PCMD}{} from before to after. Marks are means over training seeds with nominal 95\% intervals. In 14 of 15 comparisons, we find fewer solution modes after training. See Fig.\nobreakspace  {}\ref  {fig:concentration-all-scales} for other model scales.}}{7}{figure.33}\protected@file@percent }
\newlabel{fig:concentration-story}{{8}{7}{\textbf {Training reduces solution mode diversity.} We compare \pmd {} before and after RLVR on Qwen2.5-3B, over \mb {} Level 1 test set, under three objectives, five domains, five seeds. The figure shows the change in \pmd {} from before to after. Marks are means over training seeds with nominal 95\% intervals. In 14 of 15 comparisons, we find fewer solution modes after training. See Fig.~\ref {fig:concentration-all-scales} for other model scales}{figure.33}{}}
