\@writefile{lof}{\contentsline {figure}{\numberline {27}{\ignorespaces \textbf  {\texttt  {Graph} and \texttt  {PantryPlan} lose conditional solution diversity across scales and task levels.} Changes in \texttt  {PCMD}{}, in percentage points. \textbf  {(A)} Initial-to-final changes at Level\nobreakspace  {}1 across three model scales and three objectives. Each seed averages over prompts with at least two correct responses at both checkpoints. Filled marks and bars show five-seed means and nominal paired 95\% Student-$t$ intervals; open marks show partial-seed means without intervals. Annotated hollow symbols identify objectives with no jointly eligible prompts. Dr.GRPO and GRPO reduce diversity in \texttt  {Graph} and \texttt  {PantryPlan} at every scale. \textbf  {(B)} Level-1-trained policies evaluated on Levels\nobreakspace  {}1--5, with Levels\nobreakspace  {}2--5 measuring transfer. Available evaluations are averaged within each scale, then available scales receive equal weight. Repeated evaluations under different context limits remain separate entries, without representing additional training seeds. Each scale uses one initial checkpoint evaluation. Bars appear only when one scale contributes and give nominal 95\% Student-$t$ intervals over its training seeds. Open marks indicate that at least one contributing scale has fewer than 30 eligible initial prompts or fewer than 30 eligible trained prompt observations in total. Missing initial references have fewer than two eligible prompts. GRPO appears only at Level\nobreakspace  {}1. \texttt  {Graph} and \texttt  {PantryPlan} means decrease at every level; \texttt  {Countdown} increases at Levels\nobreakspace  {}4--5.}}{51}{figure.212}\protected@file@percent }
\newlabel{fig:concentration-all-scales}{{27}{51}{\textbf {\texttt {Graph} and \texttt {PantryPlan} lose conditional solution diversity across scales and task levels.} Changes in \pmd {}, in percentage points. \textbf {(A)} Initial-to-final changes at Level~1 across three model scales and three objectives. Each seed averages over prompts with at least two correct responses at both checkpoints. Filled marks and bars show five-seed means and nominal paired 95\% Student-$t$ intervals; open marks show partial-seed means without intervals. Annotated hollow symbols identify objectives with no jointly eligible prompts. Dr.GRPO and GRPO reduce diversity in \texttt {Graph} and \texttt {PantryPlan} at every scale. \textbf {(B)} Level-1-trained policies evaluated on Levels~1--5, with Levels~2--5 measuring transfer. Available evaluations are averaged within each scale, then available scales receive equal weight. Repeated evaluations under different context limits remain separate entries, without representing additional training seeds. Each scale uses one initial checkpoint evaluation. Bars appear only when one scale contributes and give nominal 95\% Student-$t$ intervals over its training seeds. Open marks indicate that at least one contributing scale has fewer than 30 eligible initial prompts or fewer than 30 eligible trained prompt observations in total. Missing initial references have fewer than two eligible prompts. GRPO appears only at Level~1. \texttt {Graph} and \texttt {PantryPlan} means decrease at every level; \texttt {Countdown} increases at Levels~4--5}{figure.212}{}}
\newlabel{fig:concentration-levels}{{27}{51}{\textbf {\texttt {Graph} and \texttt {PantryPlan} lose conditional solution diversity across scales and task levels.} Changes in \pmd {}, in percentage points. \textbf {(A)} Initial-to-final changes at Level~1 across three model scales and three objectives. Each seed averages over prompts with at least two correct responses at both checkpoints. Filled marks and bars show five-seed means and nominal paired 95\% Student-$t$ intervals; open marks show partial-seed means without intervals. Annotated hollow symbols identify objectives with no jointly eligible prompts. Dr.GRPO and GRPO reduce diversity in \texttt {Graph} and \texttt {PantryPlan} at every scale. \textbf {(B)} Level-1-trained policies evaluated on Levels~1--5, with Levels~2--5 measuring transfer. Available evaluations are averaged within each scale, then available scales receive equal weight. Repeated evaluations under different context limits remain separate entries, without representing additional training seeds. Each scale uses one initial checkpoint evaluation. Bars appear only when one scale contributes and give nominal 95\% Student-$t$ intervals over its training seeds. Open marks indicate that at least one contributing scale has fewer than 30 eligible initial prompts or fewer than 30 eligible trained prompt observations in total. Missing initial references have fewer than two eligible prompts. GRPO appears only at Level~1. \texttt {Graph} and \texttt {PantryPlan} means decrease at every level; \texttt {Countdown} increases at Levels~4--5}{figure.212}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {28}{\ignorespaces \textbf  {RLVR-only training reduces average extra verified modes at every tested scale.} Bars decompose \texttt  {distinct@8} into \texttt  {pass@8} and extra verified modes before training and after eight passes. Panels show Dr.GRPO and GRPO across three models and five domains: 150 runs, with five seeds per cell and four eight-response groups per checkpoint. Whiskers show the seed range; each method uses its own initial evaluation. Badges give the percentage change in extra modes only where the initial mean exceeds $.05$; the other three domains start at $.011$ or less.}}{52}{figure.215}\protected@file@percent }
\newlabel{fig:baseline-precheck}{{28}{52}{\textbf {RLVR-only training reduces average extra verified modes at every tested scale.} Bars decompose \texttt {distinct@8} into \texttt {pass@8} and extra verified modes before training and after eight passes. Panels show Dr.GRPO and GRPO across three models and five domains: 150 runs, with five seeds per cell and four eight-response groups per checkpoint. Whiskers show the seed range; each method uses its own initial evaluation. Badges give the percentage change in extra modes only where the initial mean exceeds $.05$; the other three domains start at $.011$ or less}{figure.215}{}}
