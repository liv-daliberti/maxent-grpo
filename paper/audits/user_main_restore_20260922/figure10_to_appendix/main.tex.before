  \centering
  \caption{\textbf{Compared objectives under Qwen2.5-0.5B, \mb{} Level 1.} Each method is compared against the same task performed under Dr.GRPO; avg weights the five domains equally within seed (5-seeds). Bold marks a column's best. An em-dash means that there are few more-than-one solution pairs to evaluate. Worst LMs are in red; best LMs are in green; scaled to that column's largest magnitude.}
  \label{tab:direct-comparator-matrix}
  \scriptsize
  % Thirteen columns with the domains spelled out. The two widest headers,
  % Countdown and PantryPlan, are split across two lines to keep the table
  % compact while preserving full domain names.
  \setlength{\tabcolsep}{1.4pt}
  \renewcommand{\arraystretch}{0.95}
  \begin{tabular}{@{}l*{12}{r}@{}}
    \toprule
    & \multicolumn{6}{c}{\textbf{$\Delta$ \texttt{pass@8}}}
      & \multicolumn{6}{c}{\textbf{$\Delta$ \pmd{}}} \\
    \cmidrule(lr){2-7}\cmidrule(l){8-13}
    & \texttt{Graph}
