  \small
  \setlength{\tabcolsep}{6pt}
  \begin{tabular}{@{}lrrrr@{}}
    \toprule
    \textbf{Regularizer} & $d=10^{-3}$ & $10^{-4}$ & $10^{-5}$ & $10^{-6}$ \\
    \midrule
